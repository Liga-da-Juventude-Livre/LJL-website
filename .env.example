# Copy to .env and fill in. Never commit .env.

# Neon → your project → Connect. Use the POOLED string (host contains "-pooler") for the running app:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# …and the DIRECT (non-pooled) string for migrations and the seed:
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional: cap on database connections per server instance (default 10).
# DATABASE_POOL_MAX=5

# Public address of the site, used in certificate QR codes and absolute links. Required in production.
# SITE_URL="https://seu-dominio.org"

# Salt for hashing visitor IPs (used only to rate-limit the public chapter-request form). Set any long random string.
# IP_HASH_SALT="troque-por-um-texto-aleatorio-longo"

# Optional: password of the sample logins created by `npm run db:seed:demo` (development only). Default: liga-demo-2026
# SEED_DEMO_PASSWORD="outra-senha-de-exemplo"

# Image uploads (Vercel Blob). Created by Vercel when you connect a Blob store to the project (Storage → Blob → Connect).
# Locally: `vercel env pull`, or copy the token here. Without it the dashboard works; the upload buttons stay disabled.

# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_…"

# First administrator, created by `npm run db:seed` (asks to change the password on first login).
SEED_ADMIN_NAME="Seu nome"
SEED_ADMIN_EMAIL="voce@exemplo.com"
SEED_ADMIN_PASSWORD="troque-por-uma-senha-de-10-ou-mais-caracteres"
